{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@openstudy/import-core": ["../../packages/import-core/src/index.ts"],
      "@openstudy/mapping": ["../../packages/structured-mapping/src/index.ts"],
      "@openstudy/schema": ["../../packages/schema/src/index.ts"],
      "@openstudy/study": ["../../packages/study/src/index.ts"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "e2e", "*.config.ts"]
}
