{
  "name": "@openstudy/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical, versioned StudySet schema for OpenStudy",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./study-set.schema.json": "./study-set.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "study-set.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:json-schema": "tsx scripts/generate-json-schema.ts --check",
    "generate:json-schema": "tsx scripts/generate-json-schema.ts",
    "test": "tsx --test test/study-set.test.ts test/json-schema.test.ts test/migration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
